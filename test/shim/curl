#!/usr/bin/env bash
# test/shim/curl - a test double of curl for test/run.sh. It answers what nb-prober asks of Evolution and
# of the monitored targets from files in $SHIM_DIR, and logs what it was asked. It does not touch the network.
#
#   $SHIM_DIR/monitors.json      body for GET /api/v1/probe/monitors (code: list_code, default 200)
#   $SHIM_DIR/post_code          status for POST /api/v1/probe/monitors/<id>/results (default 200)
#   $SHIM_DIR/offline            exists: every Evolution call fails like a refused connection (000)
#   $SHIM_DIR/target/<url>       a monitored target (the URL with non-alphanumerics -> _): lines
#                                "status=200", "time=0.123" (seconds), "exit=0" (curl's exit code: 28 timeout,
#                                7 refused, 63 body cut), "body=text". A missing file: refused (exit 7)
#   $SHIM_DIR/posts/<n>.json     every POST body, in order
#   $SHIM_DIR/requests.log       "METHOD URL" per call; args.log: the raw arguments; auth.log: "ok" when the
#                                Authorization header arrived on stdin (-K -)
set -u
: "${SHIM_DIR:?}"
all="$*"
out=""; method=GET; body=""; url=""; cfg=0; wfmt=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -w) wfmt="$2"; shift 2 ;;
    -X) method="$2"; shift 2 ;;
    -K) cfg=1; shift 2 ;;
    -H|-A|--max-time|--max-redirs|--proto|--proto-redir|--max-filesize) shift 2 ;;
    --data-binary) body="${2#@}"; shift 2 ;;
    -I) method=HEAD; shift ;;
    -sS|-L|--get) shift ;;
    http*) url="$1"; shift ;;
    *) shift ;;
  esac
done
printf '%s\n' "$all" >> "$SHIM_DIR/args.log"
stdin=""; [ "$cfg" = 1 ] && stdin=$(cat)
printf '%s %s\n' "$method" "$url" >> "$SHIM_DIR/requests.log"
code() { if [ -n "$wfmt" ]; then printf '%s' "$1"; fi; }
reply() { # reply CODE BODYFILE
  [ -n "$out" ] && cat "$2" > "$out"
  code "$1"; exit 0
}
case "$url" in
  http://evolution.test/*) ;;
  *)
    f="$SHIM_DIR/target/$(printf '%s' "$url" | tr -c 'A-Za-z0-9' _)"
    [ -f "$f" ] || { code "000 0.000000 0.000000"; exit 7; }
    status=$(sed -n 's/^status=//p' "$f"); t=$(sed -n 's/^time=//p' "$f"); rc=$(sed -n 's/^exit=//p' "$f")
    if [ -n "$out" ]; then
      if [ "$method" = HEAD ]; then : > "$out"; else sed -n 's/^body=//p' "$f" > "$out"; fi
    fi
    code "${status:-000} ${t:-0.001} ${t:-0.001}"
    exit "${rc:-0}" ;;
esac
# Evolution
if [ -e "$SHIM_DIR/offline" ]; then code 000; exit 7; fi
case "$stdin" in *"Authorization: Bearer ${NB_PROBER_KEY-}"*) echo ok >> "$SHIM_DIR/auth.log" ;; esac
v=$(printf '%s' "$stdin" | sed -n 's/^header = "X-Prober-Version: \(.*\)"$/\1/p')
[ -n "$v" ] && echo "$v" >> "$SHIM_DIR/version.log"
case "$method $url" in
  "GET "*/api/v1/probe/monitors)
    c=$(cat "$SHIM_DIR/list_code" 2>/dev/null || echo 200)
    reply "$c" "$SHIM_DIR/monitors.json" ;;
  "POST "*/results)
    mkdir -p "$SHIM_DIR/posts"
    n=$(find "$SHIM_DIR/posts" -type f | wc -l | tr -d ' ')
    cp "$body" "$SHIM_DIR/posts/$((n + 1)).json"
    c=$(cat "$SHIM_DIR/post_code" 2>/dev/null || echo 200)
    count=$(jq '.results | length' "$body")
    printf '{"success":true,"data":{"accepted":%s,"duplicates":0,"rejected":[]}}' "$count" > "$SHIM_DIR/ack.json"
    reply "$c" "$SHIM_DIR/ack.json" ;;
esac
code 404; [ -n "$out" ] && : > "$out"; exit 0
