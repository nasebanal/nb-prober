#!/usr/bin/env bash
# nb-prober - check services on a private network from inside it and report to NASEBANAL Evolution
#
# Usage: nb-prober <command> [options]
# Also runs as: nb prober <command> [options]   (through the nb command, nb 0.15.0 or later)
#
# Commands:
#   run                                  check this probe's monitors on their intervals and report, until stopped
#   list                                 list the monitors assigned to this probe
#   check <url>                          check one URL the way a monitor would, and print the outcome (reports nothing)
#   doctor                               check the setup (tools, token, Evolution, state directory)
#   --install [DIR]                      link this script into DIR (default ~/.local/bin)
#
# Options:
#   --probe NAME                         which probe this is: the `probe` name of its monitors (or NB_PROBER_NAME)
#   --once                               run: one pass, then exit (for cron or a test)
#   --dry-run                            run: check and print, but report nothing and keep nothing
#   --method GET|HEAD                    check: the request method (default GET)
#   --expect-status CODE                 check: the status that counts as ok (default: any 2xx or 3xx)
#   --keyword TEXT                       check: text the body must contain (GET only)
#   --timeout-ms MS                      check: give up after MS milliseconds (default 10000)
#   -h, --help                           show this help (with no command: the usage, exit 1)
#   --version                            show the version
#
# How it works: a push monitor in NASEBANAL Evolution has the same settings as a cloud monitor (URL,
# method, expected status, keyword, timeout, interval) plus a probe name. This program runs INSIDE
# your private network: it asks Evolution for the monitors of its probe name, makes the request of each
# one when its interval is due, and reports the outcome (ok, status code, response time, error) over
# HTTPS. The settings come from Evolution on every pass, so a change on the monitor's screen takes
# effect on the next one. Evolution never connects to your network: this program only makes outgoing
# requests, and it judges a response exactly as Evolution's own checker does.
#
# run      one pass every NB_PROBER_TICK seconds (default 15): list the monitors, check the ones
#          that are due (a failed check is repeated once, as Evolution's own checker does), append
#          each outcome to a buffer file, then send the buffer oldest first, 100 at a time. While
#          Evolution cannot be reached the last list of monitors is used, the buffer keeps growing and
#          is flushed when the link returns (the newest NB_PROBER_BUFFER_MAX = 10000 per monitor are
#          kept; Evolution accepts results up to 7 days old).
# list     the monitors assigned to --probe: id, interval in minutes, method, state, URL.
# check    one check of <url> with the options above, to try a URL from this machine before registering
#          a monitor. Prints the outcome as JSON. Exits 0 if the target is ok, 1 if not.
# doctor   check the setup without reporting anything: curl and jq installed, token set, Evolution
#          reachable and the token accepted, the state directory writable. Exits 1 if anything is flagged.
# --install  put `nb-prober` on your PATH: a symlink to this script in DIR (default ~/.local/bin,
#          created if missing), so a `git pull` of this repository updates it. It does not replace
#          anything it did not make, and prints the line to add if DIR is not on your PATH.
#
# How a response is judged (the same as Evolution's checker):
#   - redirects are followed (up to 20); only http and https are requested
#   - ok if the status is the expected one, or, with none set, any 2xx or 3xx
#   - with a keyword and GET, the first 1 MiB of the body must contain it
#   - response_ms is the time until the response headers arrive
#   - errors: timeout (no complete answer in time), connection_failed (DNS, refused, TLS, ...),
#     unexpected_status, keyword_not_found
#
# Safety:
#   - the token is never put in a command line or a log: curl reads it from stdin
#   - nothing is requested but Evolution (HTTPS) and the URLs of the monitors you registered
#   - a monitor that Evolution no longer lists as push (404 / 409) has its buffer dropped
#
# Environment:
#   NB_PROBER_TOKEN             an Evolution API token (a personal access token). Use a dedicated
#                               token-only user for each probe. NB_TOKEN is read if it is not set
#   NB_ASSURANCE_BASE_URL       Evolution's API (default https://api.assurance.nasebanal.com)
#   NB_ACTIVE_ORGANIZATION_ID   act in this organization (optional)
#   NB_PROBER_NAME              the probe name, instead of --probe
#   NB_PROBER_STATE_DIR         buffer and last-check times (default ~/.local/state/nb-prober)
#   NB_PROBER_TICK              seconds between passes (default 15)
#   NB_PROBER_BUFFER_MAX        results kept per monitor while Evolution is unreachable (default 10000)
#   NB_PROBER_RETRY_WAIT        seconds before a failed check is repeated once (default 0)
set -euo pipefail

VERSION="0.1.0"
SELF="${BASH_SOURCE[0]}"

# Layout (the same in nb, nb-secrets, nb-quickstarts and nb-prober): Usage first, then one description line, "<emoji> NASEBANAL <Name> -
# <what it does>", then Commands and Options. The description is the first comment line above, so `nb -h` (which reads it
# without running anything) and this text cannot differ. When the nb command runs this tool (`nb prober ...`, which
# sets NB_PLUGIN_NAME) the name shown is the one the user typed.
help() {
  local desc text
  desc=$(sed -n '2s/^# nb-prober - //p' "$SELF")
  text=$(sed -n '3,/^set -euo pipefail/{/^set -euo pipefail/!p;}' "$SELF" | sed 's/^# \{0,1\}//' |
    awk -v t="📡 NASEBANAL Prober - $desc" 'NR == 1 && $0 == "" { next } /^Commands:/ && !done { print t; print ""; done = 1 } { print }')
  if [ "${NB_PLUGIN_NAME-}" = "nb prober" ]; then
    text=$(printf '%s\n' "$text" | sed -e '/^Also runs as:/d' -e 's/nb-prober/nb prober/g')
  fi
  printf '%s\n' "$text"
}
usage() { help | sed -n '1,/^How it works/{/^How it works/!p;}' >&2; exit 1; }
die() { echo "nb-prober: $*" >&2; exit 1; }
warn() { echo "nb-prober: $*" >&2; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
say() { printf '%s %s\n' "$(now)" "$*"; }

PROBE="${NB_PROBER_NAME:-}"
API="${NB_ASSURANCE_BASE_URL:-https://api.assurance.nasebanal.com}"
TOKEN="${NB_PROBER_TOKEN:-${NB_TOKEN:-}}"
ORG="${NB_ACTIVE_ORGANIZATION_ID:-}"
STATE_ROOT="${NB_PROBER_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/nb-prober}"
TICK="${NB_PROBER_TICK:-15}"
BUFFER_MAX="${NB_PROBER_BUFFER_MAX:-10000}"
RETRY_WAIT="${NB_PROBER_RETRY_WAIT:-0}"
ONCE=0; DRY=0; METHOD=GET; EXPECT=""; KEYWORD=""; TIMEOUT_MS=10000
UA="NASEBANAL-Prober/$VERSION (+https://www.nasebanal.com)"
POS=()
TMP=""
# What `run` has already complained about, so a link that stays down is said once, not every pass.
LINK_KEY=""; FLUSH_WARNED=""

need() { command -v "$1" >/dev/null || die "$1 is not installed"; }
need_token() { [ -n "$TOKEN" ] || die "no token: set NB_PROBER_TOKEN (an Evolution API token)"; }
need_probe() {
  [ -n "$PROBE" ] || die "which probe? give --probe NAME (or set NB_PROBER_NAME)"
  printf '%s' "$PROBE" | grep -Eq '^[a-z0-9][a-z0-9._-]{0,63}$' || die "invalid probe name: $PROBE (lowercase letters, digits, . _ -; up to 64)"
}
make_tmp() { TMP=$(mktemp -d "${TMPDIR:-/tmp}/nb-prober.XXXXXX"); trap 'rm -rf "$TMP"' EXIT; }

# http METHOD URL [BODYFILE]: call Evolution. Sets HTTP_CODE (000 if unreachable) and HTTP_BODY (a file).
# The token and the organization header go to curl on stdin, so they never appear in `ps`.
HTTP_CODE=000; HTTP_BODY=""
http() {
  local method="$1" url="$2" body="${3:-}" args cfg
  HTTP_BODY="$TMP/response.json"; : > "$HTTP_BODY"
  args=(-sS -o "$HTTP_BODY" -w '%{http_code}' --max-time 30 -X "$method" -K -)
  cfg=$(printf 'header = "Authorization: Bearer %s"\n' "$TOKEN")
  [ -z "$ORG" ] || cfg="$cfg"$'\n'"$(printf 'header = "X-Active-Organization-Id: %s"' "$ORG")"
  if [ -n "$body" ]; then args+=(-H 'Content-Type: application/json' --data-binary "@$body"); fi
  HTTP_CODE=$(printf '%s\n' "$cfg" | curl "${args[@]}" "$url" 2>/dev/null) || HTTP_CODE=000
  [ -n "$HTTP_CODE" ] || HTTP_CODE=000
}

# probe_once URL METHOD TIMEOUT_MS EXPECTED KEYWORD: one request, judged as Evolution's own checker does.
# Prints the outcome as one JSON line (the shape of a result in the report).
probe_once() {
  local url="$1" method="$2" tmo="$3" expected="$4" keyword="$5" at secs args w rc code ttfb total ms sc ok err
  at=$(now)
  secs=$(awk -v t="$tmo" 'BEGIN { printf "%.3f", t / 1000 }')
  args=(-sS -L --max-redirs 20 --proto '=http,https' --proto-redir '=http,https' --max-time "$secs"
        -A "$UA" -H 'Accept: */*' --max-filesize 1048576 -o "$TMP/target.body"
        -w '%{http_code} %{time_starttransfer} %{time_total}')
  if [ "$method" = HEAD ]; then args+=(-I); fi
  w=$(curl "${args[@]}" "$url" 2>/dev/null) && rc=0 || rc=$?
  code=000; ttfb=0; total=0
  # shellcheck disable=SC2034
  read -r code ttfb total <<< "$w" || true
  code=${code:-000}
  ok=false; err=""; sc=null
  if { [ "$rc" -ne 0 ] && [ "$rc" -ne 63 ]; } || [ "$code" = 000 ]; then
    # No complete answer (63 only means the 1 MiB cap cut a long body, which is fine).
    if [ "$rc" -eq 28 ]; then err=timeout; else err=connection_failed; fi
    ms=$(awk -v d="${total:-0}" 'BEGIN { printf "%d", d * 1000 + 0.5 }')
  else
    sc=$((10#$code))
    ms=$(awk -v d="${ttfb:-0}" 'BEGIN { printf "%d", d * 1000 + 0.5 }')
    if [ -n "$expected" ]; then
      [ "$sc" -eq "$expected" ] || err=unexpected_status
    else
      { [ "$sc" -ge 200 ] && [ "$sc" -lt 400 ]; } || err=unexpected_status
    fi
    if [ -z "$err" ] && [ -n "$keyword" ] && [ "$method" = GET ]; then
      head -c 1048576 "$TMP/target.body" | grep -aFq -- "$keyword" || err=keyword_not_found
    fi
    [ -n "$err" ] || ok=true
  fi
  jq -cn --arg at "$at" --argjson ok "$ok" --argjson sc "$sc" --argjson ms "$ms" --arg err "$err" \
    '{checked_at: $at, ok: $ok, status_code: $sc, response_ms: $ms, error: (if $err == "" then null else $err end)}'
}

# check_monitor URL METHOD TIMEOUT_MS EXPECTED KEYWORD: probe_once, repeated once if it failed. The
# outcome of the final attempt is the one reported (a dropped packet should not open an incident).
check_monitor() {
  local out
  out=$(probe_once "$@")
  if [ "$(printf '%s' "$out" | jq -r '.ok')" != true ]; then
    sleep "$RETRY_WAIT"
    out=$(probe_once "$@")
  fi
  printf '%s\n' "$out"
}

# flush ID: send one monitor's buffered results, oldest first, 100 per request. Returns 1 if some stay buffered.
flush() {
  local id="$1" f="$BUF/$1.jsonl" n
  while [ -s "$f" ]; do
    head -n 100 "$f" > "$TMP/batch.jsonl"
    n=$(wc -l < "$TMP/batch.jsonl" | tr -d ' ')
    if ! jq -s '{results: .}' "$TMP/batch.jsonl" > "$TMP/batch.json" 2>/dev/null; then
      warn "monitor $id: unreadable buffer, dropped"; : > "$f"; return 0
    fi
    http POST "$API/api/v1/monitors/$id/results" "$TMP/batch.json"
    case "$HTTP_CODE" in
      200)
        say "reported $n result(s) for $id: $(jq -r '.data | "accepted \(.accepted), duplicates \(.duplicates), rejected \(.rejected | length)"' "$HTTP_BODY" 2>/dev/null || echo ok)" ;;
      400|404|409)
        # The batch can never be accepted (the monitor is gone, not push any more, or the items are invalid): drop it.
        warn "monitor $id: report refused (HTTP $HTTP_CODE), $n result(s) dropped" ;;
      401|403|*)
        case "$FLUSH_WARNED" in
          *"|$id:$HTTP_CODE|"*) ;;
          *)
            FLUSH_WARNED="$FLUSH_WARNED|$id:$HTTP_CODE|"
            if [ "$HTTP_CODE" = 401 ] || [ "$HTTP_CODE" = 403 ]; then
              warn "token refused (HTTP $HTTP_CODE); results stay buffered for $id ($(wc -l < "$f" | tr -d ' ') so far)"
            else
              warn "cannot reach Evolution (HTTP $HTTP_CODE); results stay buffered for $id ($(wc -l < "$f" | tr -d ' ') so far)"
            fi ;;
        esac
        return 1 ;;
    esac
    tail -n +$((n + 1)) "$f" > "$f.new"; mv "$f.new" "$f"
    FLUSH_WARNED=${FLUSH_WARNED//"|$id:"[0-9][0-9][0-9]"|"/}
  done
  return 0
}

# One pass: list the probe's monitors, check the ones that are due, then flush every buffer. While
# Evolution cannot be reached (no answer, or a 5xx) the last list it gave is used, so checking goes
# on and the results pile up in the buffer for the flush.
cycle() {
  local id name url method tmo expected keyword interval last t out f list="$STATE_ROOT/$PROBE/monitors.tsv" have=0
  http GET "$API/api/v1/monitors?mode=push&probe=$PROBE"
  if [ "$HTTP_CODE" = 200 ] && jq -e '.data.data' "$HTTP_BODY" >/dev/null 2>&1; then
    # One line per enabled monitor, fields joined by the unit separator (so an empty one stays empty).
    jq -r '.data.data[] | select(.enabled) | [.id, (.name // .url), .url, (.method // "GET"), (.timeout_ms // 10000), (.expected_status // ""), ((.keyword // "") | gsub("[\\n\\r]"; " ")), .interval_minutes] | map(tostring) | join("\u001f")' \
      "$HTTP_BODY" > "$TMP/monitors.tsv"
    have=1
    if [ "$DRY" != 1 ]; then cp "$TMP/monitors.tsv" "$list"; fi
    if [ -n "$LINK_KEY" ]; then say "Evolution is reachable again"; LINK_KEY=""; fi
  else
    local msg=""
    case "$HTTP_CODE" in
      401|403) msg="token refused (HTTP $HTTP_CODE) when listing the monitors of probe $PROBE" ;;
      000|5??)
        if [ "$DRY" != 1 ] && [ -f "$list" ]; then
          cp "$list" "$TMP/monitors.tsv"; have=1
          msg="cannot list the monitors of probe $PROBE (HTTP $HTTP_CODE); using the last list until it answers"
        else
          msg="cannot list the monitors of probe $PROBE (HTTP $HTTP_CODE)"
        fi ;;
      *) msg="cannot list the monitors of probe $PROBE (HTTP $HTTP_CODE)" ;;
    esac
    if [ "$LINK_KEY" != "$HTTP_CODE" ]; then warn "$msg"; LINK_KEY="$HTTP_CODE"; fi
  fi
  if [ "$have" = 1 ]; then
    while IFS=$'\x1f' read -r id name url method tmo expected keyword interval; do
      t=$(date +%s); last=0
      [ -f "$LAST/$id" ] && last=$(cat "$LAST/$id")
      [ $((t - last)) -ge $((interval * 60)) ] || continue
      out=$(check_monitor "$url" "$method" "$tmo" "$expected" "$keyword")
      say "$(printf '%s' "$out" | jq -r 'if .ok then "ok  " else "DOWN" end + "  \(.response_ms) ms  \(.status_code // "-")  \(.error // "")"') $name"
      [ "$DRY" = 1 ] && continue
      printf '%s\n' "$out" >> "$BUF/$id.jsonl"
      if [ "$(wc -l < "$BUF/$id.jsonl")" -gt "$BUFFER_MAX" ]; then
        tail -n "$BUFFER_MAX" "$BUF/$id.jsonl" > "$BUF/$id.jsonl.new"; mv "$BUF/$id.jsonl.new" "$BUF/$id.jsonl"
      fi
      echo "$t" > "$LAST/$id"
    done < "$TMP/monitors.tsv"
  fi
  [ "$DRY" = 1 ] && return 0
  for f in "$BUF"/*.jsonl; do
    [ -e "$f" ] || continue
    flush "$(basename "$f" .jsonl)" || true
  done
}

cmd_run() {
  need curl; need jq; need_token; need_probe; make_tmp
  BUF="$STATE_ROOT/$PROBE/buffer"; LAST="$STATE_ROOT/$PROBE/last"
  if [ "$DRY" != 1 ]; then mkdir -p "$BUF" "$LAST"; fi
  say "probe $PROBE: reporting to $API"
  trap 'say "stopped"; exit 0' INT TERM
  while :; do
    cycle
    [ "$ONCE" = 1 ] && break
    sleep "$TICK" & wait $!
  done
}

cmd_list() {
  need curl; need jq; need_token; need_probe; make_tmp
  http GET "$API/api/v1/monitors?mode=push&probe=$PROBE"
  case "$HTTP_CODE" in
    200) ;;
    401|403) die "token refused (HTTP $HTTP_CODE)" ;;
    *) die "cannot list the monitors (HTTP $HTTP_CODE)" ;;
  esac
  printf '%-38s %8s  %-6s %-8s %s\n' ID MINUTES METHOD STATE URL
  jq -r '.data.data[] | [.id, .interval_minutes, (.method // "GET"), (.state // "-"), .url] | @tsv' "$HTTP_BODY" |
    while IFS=$'\t' read -r id interval method state url; do
      printf '%-38s %8s  %-6s %-8s %s\n' "$id" "$interval" "$method" "$state" "$url"
    done
}

cmd_check() {
  [ "${#POS[@]}" -eq 1 ] || usage
  need curl; need jq; make_tmp
  case "$METHOD" in GET|HEAD) ;; *) die "--method is GET or HEAD" ;; esac
  case "$EXPECT" in ""|[0-9][0-9][0-9]) ;; *) die "--expect-status is a three-digit status code" ;; esac
  case "$TIMEOUT_MS" in ""|*[!0-9]*) die "--timeout-ms is a number of milliseconds" ;; esac
  local out
  out=$(check_monitor "${POS[0]}" "$METHOD" "$TIMEOUT_MS" "$EXPECT" "$KEYWORD")
  printf '%s\n' "$out"
  [ "$(printf '%s' "$out" | jq -r '.ok')" = true ]
}

cmd_doctor() {
  local bad=0
  ok()   { printf '  ok    %s\n' "$1"; }
  flag() { printf '  WARN  %s\n' "$1"; bad=1; }
  make_tmp
  if command -v curl >/dev/null; then ok "curl installed"; else flag "curl is not installed"; fi
  if command -v jq >/dev/null; then ok "jq installed ($(jq --version))"; else flag "jq is not installed (brew install jq)"; fi
  if [ -n "$TOKEN" ]; then ok "token set"; else flag "no token: set NB_PROBER_TOKEN"; fi
  if [ -z "$PROBE" ]; then flag "no probe name: give --probe NAME or set NB_PROBER_NAME"
  elif printf '%s' "$PROBE" | grep -Eq '^[a-z0-9][a-z0-9._-]{0,63}$'; then ok "probe name: $PROBE"
  else flag "invalid probe name: $PROBE"; fi
  if command -v curl >/dev/null && [ -n "$TOKEN" ]; then
    http GET "$API/api/v1/monitors?mode=push${PROBE:+&probe=$PROBE}"
    case "$HTTP_CODE" in
      200) ok "Evolution reachable at $API, token accepted" ;;
      401|403) flag "Evolution at $API refused the token (HTTP $HTTP_CODE)" ;;
      000) flag "cannot reach Evolution at $API" ;;
      *) flag "Evolution at $API answered HTTP $HTTP_CODE" ;;
    esac
  fi
  if mkdir -p "$STATE_ROOT" 2>/dev/null && [ -w "$STATE_ROOT" ]; then ok "state directory writable: $STATE_ROOT"; else flag "state directory not writable: $STATE_ROOT"; fi
  [ "$bad" -eq 0 ]
}

real_path() {
  local f="$1" d l
  while [ -L "$f" ]; do
    d=$(cd "$(dirname "$f")" && pwd); l=$(readlink "$f")
    case "$l" in /*) f="$l" ;; *) f="$d/$l" ;; esac
  done
  printf '%s/%s' "$(cd "$(dirname "$f")" && pwd)" "$(basename "$f")"
}

cmd_install() {
  [ "$#" -le 1 ] || usage
  local target="${1:-$HOME/.local/bin}" me link
  me=$(real_path "$SELF")
  link="$target/nb-prober"
  mkdir -p "$target"
  if [ -L "$link" ] && [ "$(real_path "$link")" = "$me" ]; then
    echo "Already linked: $link -> $me"
  elif [ -e "$link" ] || [ -L "$link" ]; then
    die "$link already exists and is not a link to this script; remove it first if you want to replace it"
  else
    ln -s "$me" "$link"
    echo "Linked $link -> $me"
  fi
  case ":$PATH:" in
    *":$target:"*) ;;
    *) echo "Note: $target is not on your PATH; add it (for example in ~/.zshrc): export PATH=\"$target:\$PATH\"" ;;
  esac
}

case "${1:-}" in
  -h|--help|help) help; exit 0 ;;
  --version|version) echo "nb-prober $VERSION"; exit 0 ;;
  --install) shift; cmd_install "$@"; exit 0 ;;
  "") usage ;;
esac
umask 077
cmd="$1"; shift
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)   help; exit 0 ;;
    --probe)     [ "$#" -ge 2 ] || usage; PROBE="$2"; shift 2 ;;
    --probe=*)   PROBE="${1#*=}"; shift ;;
    --method)    [ "$#" -ge 2 ] || usage; METHOD="$2"; shift 2 ;;
    --method=*)  METHOD="${1#*=}"; shift ;;
    --expect-status) [ "$#" -ge 2 ] || usage; EXPECT="$2"; shift 2 ;;
    --expect-status=*) EXPECT="${1#*=}"; shift ;;
    --keyword)   [ "$#" -ge 2 ] || usage; KEYWORD="$2"; shift 2 ;;
    --keyword=*) KEYWORD="${1#*=}"; shift ;;
    --timeout-ms) [ "$#" -ge 2 ] || usage; TIMEOUT_MS="$2"; shift 2 ;;
    --timeout-ms=*) TIMEOUT_MS="${1#*=}"; shift ;;
    --once)      ONCE=1; shift ;;
    --dry-run)   DRY=1; shift ;;
    --)          shift; POS+=("$@"); break ;;
    -*)          usage ;;
    *)           POS+=("$1"); shift ;;
  esac
done
API="${API%/}"
case "$cmd" in
  run)    [ "${#POS[@]}" -eq 0 ] || usage; cmd_run ;;
  list)   [ "${#POS[@]}" -eq 0 ] || usage; cmd_list ;;
  check)  cmd_check ;;
  doctor) [ "${#POS[@]}" -eq 0 ] || usage; cmd_doctor ;;
  *)      usage ;;
esac
